\import ArendAST.Expression
\import ArendAST.Level
\import Data.Bool
\import Data.Maybe

\data Definition : \Set0
  | DFunc FuncDef
  | DData DataDef
  | DClass ClassDef
  | DField FieldDef
  | DCons ConsDef

\record FuncDef
  (name : String) (id : Nat) (params : Array Var) (resultSort : Sort) (resultType : Expr) (truncLevel : Maybe Expr) (body : Maybe Match) (isSFunc : Bool)

\record DataDef
  (name : String) (id : Nat) (params : Array Var) (sort : Sort) (constrs : Array ConsDef) (trunc : Maybe Int) (isSFunc : Bool)

\record ClassDef
  (name : String) (id : Nat) (supers : Array Nat) (fields : Array FieldDef) (impls : Nat -> Expr)
  (overrides : Nat -> Expr) (coercing : Maybe Nat) (sort : Sort) (isRecord : Bool)

\record FieldDef
  (name : String) (id : Nat) (parent : Nat) (type : Expr) (isSFunc : Bool)

\record ConsDef
  (name : String) (id : Nat) (datatype : Nat) (params : Array Var) (patterns : Maybe (Array Pattern)) (intervalmatch : Maybe Match)

\func getName (_ : Definition) : String
  | DFunc f => f.name
  | DData d => d.name
  | DClass c => c.name
  | DField f => f.name
  | DCons c => c.name

\func getId (_ : Definition) : Nat
  | DFunc f => f.id
  | DData d => d.id
  | DClass c => c.id
  | DField f => f.id
  | DCons c => c.id