\import Algebra.Meta
\import ArendAST.Definition
\import ArendAST.Expression
\import ArendAST.Level
\import ArendAST.Typecheck.Env
\import ArendAST.Typecheck.Error
\import ArendAST.Typecheck.ExprGetters
\import Arith.Int
\import Utilities.Arith
\import ArendAST.Typecheck.Unify
\import Arith.Nat
\import Data.Bool
\import Function.Meta
\import Monad.Do
\import Order.LinearOrder
\import Paths.Meta
\import Set
\import Utilities.Array
\import Utilities.Monad
\import Data.Array
\import Data.Maybe
\import Data.Fin
\import Utilities.Monad.Reader
\import ArendAST.Reduction.Normalize
\open Nat

\func typecheck (e : Expr) : Env Expr \elim e
  | EVar v => do {
    scopeCheck v,
    typecheckVar v
  }
  | EInt i => return ETInt
  | ENat n => return ETNat
  | EString s => return ETString
  | EFin m f => do {
    \lam tm => typecheck m,
    \lam tf => typecheck f,
    unify tf ETNat,
    unify tm ETNat,
    return (ETFin m)
  }
  | EApp e1 e2 isExplicit => do {
    \lam te1 => typecheck e1,
    \lam te2 => typecheck e2,
    \case getPiType te1 \with {
      | just (p :: ps, cod, s) => do {
        unify te2 (varType p),
        normalize (spineResult (p :: ps) cod s (e2 :: nil))
      }
      | _ => throw (ErrNotPi te1)
    }
  }
  | ELam a e resultSort => do {
    -- this is probably slower than doing it with lists
    forEachIndexM a.len (\lam i => localT (extendArray (take i a (linarith (fin_< i)))) (typecheckVar (a i))),
    \lam te => localT (extendArray a) (typecheck e),
    -- a lambda's type is the Pi type over its parameters into the body's type
    return (EPiType a te resultSort)
  }
  | ETuple elements e => \case getSigmaType e \with {
    | nothing => throw (ErrNotSigma e)
    | just a => \case decEqNat a.len elements.len \with {
      | no _ => throw (ErrArity a.len elements.len)
      | yes eq => do {
        -- for each element,
        forEachIndexM a.len (\lam i => localT
          -- add the types of elements before it into the context
          (extendArray
            -- with inserted elements as evaluations
            (addEvaluations (take i a (linarith (fin_< i))) (take i elements (linarith (fin_< i))))
          )
          -- and typecheck the next one
          (do {
            \lam t => typecheck (elements (rewriteI eq i)),
            unify t (varType (a i))
          })),
        return e
      }
    }
  }
  | EProj e n isProperty => do {
    \lam te => typecheck e,
    \case getSigmaType te \with {
      | nothing => throw (ErrNotSigma te)
      | just a => \case nat_<=-dec.nat_<=_Bool (suc n) a.len \with {
        | true => return (projComponentType a (just e) 0 n)
        | false => throw (ErrArity a.len n)
      }
    }
  }
  | EFunCall v l a => do {
    \lam env => askT,
    \case getDef env (getVarId v) \with {
      | just (DFunc f) => do {
        forEachIndexM a.len (\lam i => do {
          \lam ti => typecheck (a i),
          unify ti (expectedArgType f.params a i)
        }),
        normalize (spineResult f.params f.resultType Set0 a) -- FUTURE: deal with levels
      }
      | _ => throw (ErrUnbound v)
    }
  }
  | EConsCall v l typeArgs consArgs => do {
    \lam env => askT,
    \case getDef env (getVarId v) \with {
      | just (DCons c) => \case getDef env c.datatype \with {
        | just (DData d) => do {
          forEachIndexM typeArgs.len (\lam i => do {
            \lam ti => typecheck (typeArgs i),
            unify ti (expectedArgType (d.params ++ c.params) (typeArgs ++ consArgs) i)
          }),
          forEachIndexM consArgs.len (\lam i => do {
            \lam ti => typecheck (consArgs i),
            unify ti (expectedArgType (d.params ++ c.params) (typeArgs ++ consArgs) (typeArgs.len Nat.+ i))
          }),
          -- the data-type arguments must conform to the constructor's index patterns
          checkConsPatterns c typeArgs,
          normalize (EDataCall (GlobalVar d.name c.datatype (EUniv d.sort) nothing) l typeArgs)
        }
        | _ => throw (ErrUnbound v)
      }
      | _ => throw (ErrUnbound v)
    }
  }
  | EDataCall v l a => do {
    \lam env => askT,
    \case getDef env (getVarId v) \with {
      | just (DData d) => do {
        forEachIndexM a.len (\lam i => do {
          \lam ti => typecheck (a i),
          unify ti (expectedArgType d.params a i)
        }),
        normalize (spineResult d.params (EUniv d.sort) d.sort a)
      }
      | _ => throw (ErrUnbound v)
    }
  }
  | EFieldCall v e => do {
    \lam env => askT,
    \case getDef env (getVarId v) \with {
      | just (DField fd) => \case getPiType fd.type \with {
        | just (params, cod, s) => do {
          \lam te => typecheck e,
          unify te (expectedArgType params (e :: nil) 0),
          normalize (spineResult params cod s (e :: nil))
        }
        | nothing => throw (ErrNotPi fd.type)
      }
      | _ => throw (ErrUnbound v)
    }
  }
  | EClassCall v l implementations s v1 => do {
    \lam env => askT,
    forEachIndexM implementations.len (\lam i => typecheckVar (implementations i)),
    \case getDef env (getVarId v) \with {
      | just (DClass cls) => do {
        checkFieldsBelong cls implementations,
        checkNoDupFields implementations,
        return (EUniv s)
      }
      | _ => throw (ErrUnbound v)
    }
  }
  | ENew parent e => do {
    typecheckMaybe parent,
    typecheck e,
    \lam env => askT,
    \case parent, e \with {
      | nothing, EClassCall v l implementations s v1 => \case getDef env (getVarId v) \with {
        | just (DClass cls) => checkCoverage cls implementations >> normalize e
        | _ => throw (ErrUnbound v)
      }
      | _, _ => normalize e
    }
  }
  | EArray l e elems tail => do {
    typecheck e,
    forEachIndexM elems.len (\lam i => do {
      \lam ti => typecheck (elems i),
      \lam eti => normalize (EApp e (ENat i) true),
      unify ti eti
    }),
    typecheckMaybe tail,
    -- FUTURE: calculate length of tail
    return (ETArray l (\case tail \with { | nothing => ENat elems.len | just _ => EGoal }) e)
  }
  | EPath l e1 e2 => do {
    typecheck e1,
    \lam u => typecheck e2,
    unify e1 u,
    \case getPiType e1 \with {
      | just (i :: as, e, s) => do {
        unify (varType i) EInterval,
        return e1
      }
      | _ => throw (ErrNotPi e1)
    }
  }
  | EPathAt e1 e2 => do {
    \lam tp => typecheck e1,
    \lam ti => typecheck e2,
    unify ti EInterval,
    \case getPiType tp \with {
      | just (params, cod, s) => normalize (spineResult params cod s (e2 :: nil))
      | nothing => throw (ErrNotPi tp)
    }
  }
  | ETArray pls len e => do {
    \lam tl => typecheck len,
    unify tl ETNat,
    \lam tf => typecheck e,
    \case getPiType tf \with {
      | just (f :: nil, EUniv s, _) => do {
        unify (varType f) (ETFin len), -- a bit restrictive
        return (EUniv s)
      }
      | _ => throw (ErrNotPi tf)
    }
  }
  | EInterval => return (EUniv (Type level0))
  | ECase isSFunc params retType returnLevel m args => do {
    forEachIndexM args.len (\lam i => do {
      \lam ti => typecheck (args i),
      unify ti (expectedArgType params args i)
    }),
    forEachIndexM params.len (\lam i => localT (extendArray (take i params (linarith (fin_< i)))) (typecheckVar (params i))),
    localT (extendArray params) (typecheck retType),
    checkMatch m params retType,
    normalize (substParams params retType args)
  }
  | ELet isSFunc clauses e => do {
    forEachIndexM clauses.len (\lam i => typecheckLetClause (clauses i)),
    \lam vars => letClausesVars clauses,
    localT (extendArray vars) (typecheck e)
  }
  | ETyped e t => do {
    \lam te => typecheck e,
    unify te t,
    normalize t
  }
  | EBox e t => do {
    \lam te => typecheck e,
    unify te t,
    normalize t
  }
  | EPEval e => typecheck e
  | EUniv s => \case s.lp \with {
    | PLConst n => return $ EUniv $ \new Sort { | lp => PLConst (suc n) | lh => s.lh}
    | PLInf => throw ErrInfinityUniverse
    | _ => return $ EUniv $ \new Sort { | lp => PLSuc s.lp | lh => s.lh}
  }
  | EPiType params cod s => do {
    forEachIndexM params.len (\lam i => localT (extendArray (take i params (linarith (fin_< i)))) (typecheckVar (params i))),
    localT (extendArray params) (typecheck cod),
    return (EUniv s)
  }
  | ESigmaType params s => do {
    forEachIndexM params.len (\lam i => localT (extendArray (take i params (linarith (fin_< i)))) (typecheckVar (params i))),
    return (EUniv s)
  }
  | EType type l clauseNo args underlying => do {
    typecheck underlying,
    forEachIndexM args.len (\lam i => typecheck (args i)),
    normalize (EFunCall type l args)
  }
  | ETypeDestr type e => do {
    \lam env => askT,
    \lam te => typecheck e,
    \case getDef env (getVarId type) \with {
      | just (DFunc f) => \case te \with {
        | EFunCall _ _ args => \case f.body \with {
          | just (NoMatch underlying) => normalize (substParams f.params underlying args)
          | _ => return EGoal
        }
        | _ => throw ErrUnknownType
      }
      | _ => throw (ErrUnbound type)
    }
  }
  | EError (just t) => fmapM (\lam e => EError (just e)) (typecheck t)
  | EError nothing => return (EError nothing)
  | EGoal => return EGoal
  | ETInt => return (EUniv Set0)
  | ETNat => return (EUniv Set0)
  | ETFin n => do {
    \lam tn => typecheck n,
    unify tn ETNat,
    return (EUniv Set0)
  }
  | ETString => return (EUniv Set0)
  | ECSuc e => do {
    \lam tn => typecheck e,
    unify tn ETNat,
    return ETNat
  }
  | ECFSuc e e1 => do {
    \lam tm => typecheck e,
    \lam te => typecheck e1,
    unify tm ETNat,
    unify te (ETFin e),
    return (ETFin e)
  }
  | ECPos e => do {
    \lam tn => typecheck e,
    unify tn ETNat,
    return ETInt
  }
  | ECNeg e => do {
    \lam tn => typecheck e,
    unify tn ETNat,
    return ETInt
  }


\func typecheckVar (_ : Var) : Env Expr
  | GlobalVar VName VId VType (just VEvaluation) => do {
    \lam ttype => typecheck VType,
    \lam teval => typecheck VEvaluation,
    unify VType teval,
    checkIsUniv ttype,
    return VType
  }
  | LocalVar VName index VType (just VEvaluation) => do {
    \lam ttype => typecheck VType,
    \lam teval => typecheck VEvaluation,
    unify VType teval,
    checkIsUniv ttype,
    return VType
  }
  | GlobalVar VName VId VType nothing => do {
    \lam ttype => typecheck VType,
    checkIsUniv ttype,
    return VType
    }
  | LocalVar VName index VType nothing => do {
    \lam ttype => typecheck VType,
    checkIsUniv ttype,
    return VType
  }

\func typecheckMaybe (m : Maybe Expr) : Env (\Sigma) \elim m
  | nothing => return ()
  | just e  => typecheck e >> return ()

\func typecheckLetClause (c : LetClause) : Env (\Sigma) \elim c
  | cLetClause name body type _ => typecheck body >> typecheckMaybe type

\func checkPattern (pat : Pattern) (ty : Expr) : Env (\Sigma) \elim pat
  | PVar _ => return ()
  | PAbsurd => do {
    \lam env => askT,
    \case getCallDef env ty \with {
      | just (DData d) => \case d.constrs \with {
        | nil     => return ()
        | _ :: _  => throw ErrNonAbsurd
      } -- FUTURE: what if ty is not a Var/Call
      | _ => throw ErrNonAbsurd
    }
  }
  | PConstr cv subpats => do {
    \lam env => askT,
    \case getCallDef env ty \with {
      | just (DData d) => \case consById d.constrs (getVarId cv) \with {
        | nothing => throw ErrBadPattern
        | just c => \case decEqNat subpats.len c.params.len \with {
          | no _   => throw (ErrArity c.params.len subpats.len)
          | yes eq => forEachIndexM subpats.len (\lam k => checkPattern (subpats k) (varType (c.params (rewriteI eq k))))
        }
      }
      | _ => throw ErrBadPattern
    }
  }
  | PZero => unify ty ETNat
  | PFZero max => \case getFinType ty \with {
    | nothing => throw ErrBadPattern
    | just a => return ()
  }
  | PSuc pat => unify ty ETNat
  | PFSuc max pat => \case getFinType ty \with {
    | nothing => throw ErrBadPattern
    | just a => checkPattern pat (ETFin max)
  }
  | PPos pat => unify ty ETInt
  | PNeg pat => unify ty ETInt
  | PNil pls elemType => \case getArrayType ty \with {
    | nothing => throw ErrBadPattern
    | just (_, elemTy) => unify elemType elemTy
  }
  | PCons pls elemType pat1 pat2 => \case getArrayType ty \with {
    | nothing => throw ErrBadPattern
    | just (_, elemTy) => unify elemType elemTy >> checkPattern pat1 elemType >> checkPattern pat2 ty
  }
  | PIdp pls type fixedVar => unify type ty

\func checkClause (c : Clause) (params : Array Var) (retType : Expr) : Env (\Sigma) \elim c
  | cClause pats body => \case decEqNat pats.len params.len \with {
    | no _   => throw (ErrArity params.len pats.len)
    | yes eq => do {
      -- every pattern is well-formed for the type it matches
      forEachIndexM pats.len (\lam i => checkPattern (pats i) (varType (params (rewriteI eq i)))),
      -- a body-less clause must be absurd and vice versa
      checkAbsurd body (patsAnyAbsurd pats),
      -- the body is checked against the return type
      localT (extendArray (patternArrayVars pats)) -- TODO fix left=right in idp
        (checkBody body (substParams params retType (mkArray (\lam i => patternToExpr (pats i)))))
    }
  }

\func checkAbsurd (body : Maybe Expr) (absurd : Bool) : Env (\Sigma) \elim body, absurd
  | nothing, true  => return ()
  | nothing, false => throw ErrNonAbsurd
  | just _, true   => throw ErrBadPattern
  | just _, false  => return ()

\func checkBody (body : Maybe Expr) (expected : Expr) : Env (\Sigma) \elim body
  | nothing => return ()
  | just b  => do {
    \lam tb => typecheck b,
    unify tb expected
  }

\func checkMatch (m : Match) (params : Array Var) (retType : Expr) : Env (\Sigma) \elim m
  -- FUTURE: check if constructors are of the correct type
  | DoMatch clauses => forEachIndexM clauses.len (\lam i => checkClause (clauses i) params retType)
  | IntervalMatch _ _ _ => throw ErrIntervalMatch
  | NoMatch _ => return ()

\func matchPattern (_ : Expr) (_ : Pattern) : Env (\Sigma)
  | EVar _, _ => return ()
  | _, PVar _ => return ()
  | _, PAbsurd => throw ErrBadPattern
  | EConsCall cv' l' ta' ca', PConstr cv subps => \case getVarId cv ==_B getVarId cv' \with {
      | false => throw ErrBadPattern
      | true => \case decEqNat ca'.len subps.len \with {
        | no _   => throw (ErrArity subps.len ca'.len)
        | yes eq => forEachIndexM ca'.len (\lam i => matchPattern (ca' i) (subps (rewriteI eq i)))
      }
    }
  -- FUTURE: match other kinds of patterns
  | _, _ => return ()

\func checkConsPatterns (c : ConsDef) (typeArgs : Array Expr) : Env (\Sigma) => \case c.patterns \with {
  | nothing   => return ()
  | just pats => \case decEqNat typeArgs.len pats.len \with {
    | no _   => throw (ErrArity pats.len typeArgs.len)
    | yes eq => forEachIndexM typeArgs.len (\lam i => matchPattern (typeArgs i) (pats (rewriteI eq i)))
  }
}